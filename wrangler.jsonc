{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mind-of-ak-ai-studio",
  "main": "./cloudflare/src/index.ts",
  "compatibility_date": "2026-11-04",
  "vars": {
    "API_ORIGIN": "https://mind-of-ak-api.onrender.com"
  },
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {}
}
